generator client {
  provider      = "prisma-client-js"
  // linux-musl : image Docker node:alpine
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id            String   @id @default(uuid())
  title         String
  category      String // clip | realisation | directeur-photo
  role          String
  year          String
  synopsis      String?  @db.Text
  videoUrl      String?
  coverImageUrl String? // miniature
  credits       String?  @db.Text
  stills        String[]
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category, order])
}

model Review {
  id        String   @id @default(uuid())
  text      String   @db.Text
  author    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Equipment {
  id       String @id @default(uuid())
  category String
  name     String
  order    Int    @default(0)
}

model SiteSettings {
  id                    Int     @id @default(autoincrement())
  home_video_url        String?
  home_video_opacity    String?
  home_subtitle         String?
  profile_photo_url     String?
  history_text          String? @db.Text
  expertise_text        String? @db.Text
  clips_text            String? @db.Text
  demo_reel_image_url   String?
  demo_reel_link        String?
  youtube_url           String?
  linkedin_url          String?
  malt_url              String?
  instagram_url         String?
  vimeo_url             String?
  contact_email         String?
  devis_text            String? @db.Text
  mentions_legales_text String? @db.Text
  rgpd_text             String? @db.Text
}

/// Demandes reçues via le formulaire de devis (copie de sécurité si le mail échoue).
model ContactRequest {
  id         String   @id @default(uuid())
  name       String
  email      String
  type       String
  message    String   @db.Text
  status     String   @default("new") // new | read | archived
  emailSent  Boolean  @default(false)
  emailError String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
