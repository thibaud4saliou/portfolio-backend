generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id              String   @id @default(uuid())
  title           String
  category        String   
  role            String
  year            String
  synopsis        String?  @db.Text
  videoUrl        String?
  coverImageUrl   String?  // C'est la miniature !
  makingOfUrl     String?
  credits         String?  @db.Text
  stills          String[]
  order           Int      @default(0) 
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Photo {
  id          String   @id @default(uuid())
  title       String?  // NOUVEAU : Le titre de la photo
  category    String   
  subcategory String?
  imageUrl    String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model Review {
  id        String   @id @default(uuid())
  text      String   @db.Text
  author    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Equipment {
  id        String   @id @default(uuid())
  category  String   
  name      String
  order     Int      @default(0)
}

model SiteSettings {
  id                Int     @id @default(autoincrement())
  home_video_url    String?
  profile_photo_url String?
  history_text      String?
  expertise_text    String?
  clips_text        String?
  youtube_url       String?
  linkedin_url      String?
  malt_url          String?
  instagram_url     String?
  vimeo_url         String?
  devis_text            String?
  mentions_legales_text String?
  rgpd_text             String?
  contact_email          String?
  home_video_opacity     String?
  awards_image_url       String?
  demo_reel_image_url    String?
  demo_reel_link         String?
  photo_categories_order String?
}