# Copier en ".env" pour le développement local. En production, définir ces
# variables dans l'hébergeur (Render, Railway, VPS…). Ne jamais committer .env.

DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
PORT=5001

# --- Admin (obligatoire) ---------------------------------------------------
# npm run hash-password -- "VotreMotDePasse"
ADMIN_PASSWORD_HASH=scrypt:...:...
# openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_HOURS=8
# Origine publique du frontend (protection CSRF), ex. https://thibaudsaliou.fr
ALLOWED_ORIGINS=
# "false" seulement en local sans HTTPS
COOKIE_SECURE=true
# Nombre de proxys devant l'API (Vercel → Render = 2 ; nginx seul = 1)
TRUST_PROXY=1

# --- Email du formulaire de devis ------------------------------------------
# Gmail : mot de passe d'APPLICATION (myaccount.google.com/apppasswords)
EMAIL_USER=adresse@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
# (ou SMTP générique : SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS)
CONTACT_TO=thibaud.saliou@gmail.com
# Durée de conservation des demandes en base (RGPD)
CONTACT_RETENTION_DAYS=365

# --- Upload d'images (Cloudflare R2 ou S3) — optionnel ---------------------
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=portfolio-medias
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# URL publique du bucket (domaine perso R2 ou https://pub-xxxx.r2.dev)
# S3_PUBLIC_URL=https://medias.votre-domaine.fr
